# Local development secrets (copy to .env.local — never commit .env.local!)
# On Vercel, set these in Project Settings -> Environment Variables.

# 4-digit PIN to unlock Glance (optional locally; REQUIRED on Vercel — Vercel fails closed if unset)
# GLANCE_PASSCODE=1234

# Random secret (32+ characters) used to sign the session cookie. REQUIRED on Vercel.
# Generate one with: openssl rand -hex 32
# Locally it is optional; a random per-process secret is used if unset (re-enter the PIN after restarts).
# Changing it logs out every device.
# GLANCE_SESSION_SECRET=

# Option 1: Single private iCalendar (.ics) URL (Google Calendar, Apple iCloud webcal://, Outlook, etc.)
# CALENDAR_ICS_URLS=https://calendar.google.com/calendar/ical/your-id/private-token/basic.ics

# Option 2: Multiple color-coded calendars (JSON array)
# CALENDAR_ICS_URLS=[{"name":"Personal","color":"#38bdf8","url":"https://..."},{"name":"Work","color":"#a78bfa","url":"https://..."}]

# Google Photos link-shared album(s) for the Photos slide.
# Option 1: Single album
# PHOTOS_ALBUM_URL=https://photos.app.goo.gl/your-shared-album-id
# Option 2: Multiple albums (comma/newline-separated or JSON array)
# PHOTOS_ALBUM_URLS=https://photos.app.goo.gl/album-1,https://photos.app.goo.gl/album-2
