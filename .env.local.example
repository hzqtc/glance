# Local development secrets (copy to .env.local — never commit .env.local!)
# On Vercel, set CALENDAR_ICS_URLS in Project Settings -> Environment Variables.

# Option 1: Single private iCalendar (.ics) URL (Google Calendar, Apple iCloud webcal://, Outlook, etc.)
# CALENDAR_ICS_URLS=https://calendar.google.com/calendar/ical/your-id/private-token/basic.ics

# Option 2: Multiple color-coded calendars (JSON array)
# CALENDAR_ICS_URLS=[{"name":"Personal","color":"#38bdf8","url":"https://..."},{"name":"Work","color":"#a78bfa","url":"https://..."}]
